*.pem
*.key

# ── Tools ──
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ── Spark local files ──
spark-warehouse/
metastore_db/
derby.log

# ── Editor / OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db